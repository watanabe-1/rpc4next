{
  "name": "rpc4next-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watanabe-1/rpc4next.git"
  },
  "workspaces": [
    "packages/*",
    "integration/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun --filter \"./packages/*\" --if-present build",
    "clean": "bun --filter \"./packages/*\" --if-present clean",
    "typecheck": "bun run --parallel typecheck:scripts typecheck:workspaces",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "typecheck:workspaces": "bun run --parallel --filter \"./packages/*\" --filter \"./integration/*\" --if-present typecheck",
    "lint": "bun run docs:check:init && bun run format:oxfmt:check && oxlint .",
    "lint:oxlint": "oxlint .",
    "check:fix": "bun run docs:sync:init && oxfmt . && oxlint --fix .",
    "format:oxfmt": "oxfmt .",
    "format:oxfmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:client-bundle": "RPC4NEXT_RUN_CLIENT_BUNDLE_TEST=1 vitest run integration/next-app/src/client-bundle.test.ts",
    "test:coverage": "vitest run --coverage.enabled true",
    "test:package": "bun run build && bun scripts/package-smoke-test.ts",
    "test:ui": "vitest --ui --coverage.enabled true",
    "test:watch": "vitest --watch",
    "docs:sync:init": "bun scripts/sync-readme-init-snippets.ts",
    "docs:check:init": "bun scripts/sync-readme-init-snippets.ts --check",
    "integration:next-app:generate": "bun run --cwd integration/next-app generate:rpc",
    "integration:next-app:watch": "bun run --cwd integration/next-app generate:rpc:watch",
    "integration:next-app:e2e": "bun run --cwd integration/next-app e2e",
    "integration:next-app:dev": "bun run --cwd integration/next-app dev",
    "diff2prompt": "diff2prompt"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "arktype": "^2.2.8",
    "diff2prompt": "^0.0.15",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "msw": "^3.0.3",
    "next": "16.4.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "7",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "picomatch": "4.0.5",
    "postcss": "8.5.26",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
