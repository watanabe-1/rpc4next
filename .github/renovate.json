{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>watanabe-1/github-actions-common//renovate/default.json#v1"],
  "rebaseWhen": "behind-base-branch",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub CLI extensions pinned to release tags.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^(?:\\.github/)?README\\.md$/"
      ],
      "matchStrings": [
        "gh extension install (?<depName>[\\w.-]+/gh-[\\w.-]+) --pin (?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
